
import java.util.*;
class Main {
    public static void main(String[] args) {
        System.out.print("Enter the Number : ");
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int[] arr=new int[n];
        System.out.print("Enter the Elements : ");
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
    
        int single=0;
        for(int i=0;i<n;i++){
            int count =0;
            for(int j=0;j<n-1;j++){
                if(arr[j]==arr[i]){
                   count++;
                }
            }
            if(count==1){
                single=arr[i];
                break;
            }
        }
        System.out.print("Single : "+single);
    }
}
