
import java.util.*;
class Main {
    public static void main(String[] args) {
        System.out.print("Enter the Number : ");
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        for(int row=1;row<=n;row++){
            long ans=1;
           
           for(int col=0;col<row;col++){
                System.out.print(ans+" ");
                ans=ans*(row-1-col);
                ans=ans/(col+1);
            }
            System.out.println();
        }
    }
}
