import java.util.*;
class Main {
    public static void main(String[] args) {
        System.out.print("Enter the Number : ");
        Scanner sc=new Scanner (System.in);
        int n=sc.nextInt();
        int [] arr=new int[n];
        System.out.print("Enter the Elements : ");
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int Zero=0;
        for(int i=0;i<n;i++){
          for(int j=1;j<=n-1;j++){
              if(arr[j]!=Zero){
                  int temp=arr[j];
                  arr[j]=arr[j-1];
                  arr[j-1]=temp;
              }
          }
        }
        for(int i=0;i<n;i++){
            System.out.print(arr[i]+" ");
        }
    }
}
        
        
        
        
        
        
