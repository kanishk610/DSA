import java.util.*;

class Main {
    public static void main(String[] args) {
        System.out.print("Enter the Number :");
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int [] arr= new int[n];
        System.out.print("Enter the Elements : ");
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int max=0;
        int count=0;
        for(int i=0;i<n;i++){
            if(arr[i]==1){
                count++;
                max=Math.max(max,count);
            }else{
                count=0;
            }
        }
        System.out.print("MAX Consecutive Number : "+max);
        
    }
}
