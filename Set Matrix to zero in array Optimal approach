class Solution {
    public void setZeroes(int[][] matrix) {
        int n1=matrix.length;
        int n2=matrix[0].length;
        int col0=1;
        for(int i=0;i<n1;i++){
            if(matrix[i][0]==0){
                col0=0;
            }
            for(int j=1;j<n2;j++){
                if(matrix[i][j]==0){
                    matrix[i][0]=0;
                    matrix[0][j]=0;
                }
            }
        }
        for(int i=n1-1;i>=0;i--){
            for(int j=n2-1;j>=1;j--){
                if(matrix[i][0]==0||matrix[0][j]==0){
                    matrix[i][j]=0;
                }
            }
            if(col0==0){
                matrix[i][0]=0;
            }
        }

    }
}
