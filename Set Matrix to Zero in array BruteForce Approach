
import java.util.*;
class Main {
    public static void main(String[] args) {
        System.out.print("Enter the Rows : ");
        Scanner sc=new Scanner(System.in);
        int n1=sc.nextInt();
        System.out.print("Enter the Column : ");
        int n2=sc.nextInt();
        int arr[][]=new int[n1][n2];
        System.out.print("Enter the Elements : ");
        for(int i=0;i<n1;i++){
            for(int j=0;j<n2;j++){
            arr[i][j]=sc.nextInt();
                
            }
        }
         for(int i=0;i<n1;i++){
            for(int j=0;j<n2;j++){
              
              if(arr[i][j]==0){
                
                for(int col=0;col<n2;col++){
                    if(arr[i][col]!=0){
                        arr[i][col]=-1;
                    }
                    for(int row=0;row<n1;row++){
                        if(arr[row][j]!=0){
                            arr[row][j]=-1;
                        }
                    }
                    
                }
              } 
            }
            
        }
    
                
        for(int i=0;i<n1;i++){
            System.out.println();
            for(int j=0;j<n2;j++){
                if(arr[i][j]==-1){
                    arr[i][j]=0;
                }
                System.out.print(arr[i][j]+"  ");
            }
        }
            }
    }
    
