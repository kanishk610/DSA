
import java.util.*;
class Main {
    public static void main(String[] args) {
        System.out.print("Enter the Number: ");
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int [] arr=new int[n];
        System.out.print("Enter the Elements : ");
        
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
            
        }
        for(int i=1;i<=n;i++){
        boolean missing=false;
          for(int j=0;j<n-1;j++){
              if(arr[j]==i){
                  missing=true;
                  break;
              }
          }
               
           if(!missing){
               System.out.print("missing "+i);
               break;
           }
           }
        }
    }
