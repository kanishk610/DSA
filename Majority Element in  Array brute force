// Majority Element 
import java.util.*;
class Main {
    public static void main(String[] args) {
        System.out.print("Enter the Number : ");
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int [] arr=new int[n];
        System.out.print("Enter the Elements : ");
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int majority=-1;
        for(int i=0;i<n;i++){
        int count=0;
            for(int j=0;j<n;j++){
                if(arr[i]==arr[j]){
                    count++;
                }
            }
               if(count>n/2){
                   majority=arr[i];
                   break;
               } 
            }
        
       System.out.print("Majority : "+majority);
    }
}
