// Approach : Two Pointer//
// time complexity = O(n)//
import java.util.*;
class Main {
    public static void main(String[] args) {
        System.out.print("Enter the Number : ");
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int [] arr=new int[n];
        System.out.print("Enter the elements : ");
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
            
        }
        int slow=0;
        for(int i=1;i<n;i++){
            if(arr[i]!=arr[slow]){
                slow++;
                arr[slow]=arr[i];
            }
            
        }
        for(int i=0;i<=slow;i++){
            System.out.print(arr[i]+" ");
        }
    }
}
