
import java.util.*;
class Main {
    public static void main(String[] args) {
        System.out.print("Enter the Number : ");
      Scanner sc =new Scanner(System.in);
        int n=sc.nextInt();
        int[] arr=new int[n];
        System.out.print("Enter the Elements : ");
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int sum=n*(n+1)/2;
        int sum2=0;
        for(int i=0;i<n-1;i++){
            sum2+=arr[i];
        }
        int missing=sum-sum2;
        System.out.print(missing);
    }
}
