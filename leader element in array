
import java.util.*;
class Main {

    public static void main(String[] args) {
        System.out.print("Enter the Number : ");
        Scanner sc= new Scanner(System.in);
        int n=sc.nextInt();
        int [] arr=new int[n];
        System.out.print("Enter the Elements : " );
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int max=Integer.MIN_VALUE;
        for(int i=n-1;i>=0;i--){
            if(arr[i]>max){
                max=arr[i];
                System.out.print(arr[i]+" ");
            }
        }
           
    
}
}
