class Solution {
    public int maxProduct(int[] nums) {
        int max = -1;
        int max2 = -1;
        int n = nums.length;
        for(int i=0; i<n; i++) {
            if(max<=nums[i]){
                max2 = max;
                max = nums[i];
                
            }
            else if(max2<nums[i]){
                max2 = nums[i];
            }
        }
        return (max-1)*(max2-1);
    }
}
